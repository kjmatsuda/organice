{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "chrome",
      "request": "launch",
      "name": "Launch Chrome with Parcel",
      "url": "http://localhost:3000/apps/organice/",
      "webRoot": "${workspaceFolder}",
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "/__parcel_source_root/src/*": "${webRoot}/src/*"
      }
    }
  ]
}
